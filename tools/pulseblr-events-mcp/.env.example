# Adapted from template/.env.example for a key-free MCP server.
#
# No environment variables or secrets are required.
# This package does not automatically load .env files.
# Do not add API keys, tokens, cookies, database URLs, or service-account files.
#
# Select configuration through CLI arguments instead:
#   python -m pulseblr_events_mcp --source live
#   python -m pulseblr_events_mcp --source sample --now 2026-10-24T08:00:00+05:30
#
# --source defaults to live. --now is accepted only with --source sample.
# There is no need to copy this file to .env.
